TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_IDS=
POSTGRES_PASSWORD=change-this-before-deployment
DATABASE_URL=postgresql+asyncpg://monitor:change-this-before-deployment@postgres:5432/monitor
DMSU_ENABLED=true
DOCUMENT_ENABLED=true
DOCUMENT_BROWSER_HEADLESS=false
DMSU_POLL_INTERVAL=60
DOCUMENT_POLL_INTERVAL=90
DMSU_FAST_ENABLED=false
DMSU_FAST_START=23:55
DMSU_FAST_END=00:10
DMSU_FAST_INTERVAL=30
JITTER=0.15
HTTP_TIMEOUT=20
MAX_RETRIES=2
BACKOFF_FACTOR=2
GLOBAL_REQUEST_INTERVAL=1
PROVIDER_REQUEST_INTERVAL=2
CIRCUIT_THRESHOLD=5
CIRCUIT_COOLDOWN=300
ADMIN_FAILURE_THRESHOLD=3
ADMIN_COOLDOWN=1800
REAPPEARANCE_COOLDOWN=600
CATALOG_TTL=21600
MAX_CONCURRENT_JOBS=4
METRICS_PORT=8080
# Dashboard: http://127.0.0.1:8080/dashboard (disabled until password is set)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
LOG_LEVEL=INFO
TZ=Europe/Kyiv
